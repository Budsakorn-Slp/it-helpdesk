# copy ไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ขึ้น git
# (config.py รองรับทั้งชื่อ ".env" และ "env" เพื่อความเข้ากันได้กับของเดิม)

# ── Oracle — ดึงข้อมูลพนักงาน + เก็บเอกสาร ──
# ไม่มีค่า default ในโค้ดแล้ว ถ้าไม่ตั้ง 3 ตัวนี้ app จะ error ตอนต่อ DB
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:port/service_name

# path ของ Oracle Instant Client — เว้นว่างได้ถ้า client อยู่ใน PATH แล้ว
# หรือถ้าใช้ oracledb แบบ thin mode (app_prod.py)
ORACLE_CLIENT_LIB_DIR=

# หมายเหตุ: MYSQL_* ถูกตัดออกแล้ว — โค้ดปัจจุบันใช้ Oracle อย่างเดียว
# (ไม่มี import mysql ที่ไหนเลย) ถ้าจะกลับมาใช้ค่อยเพิ่มใหม่

# ── LINE Messaging API ──
LINE_CHANNEL_TOKEN=

# ── Flask ──
# URL ที่ผู้ใช้กดจากข้อความ LINE ต้องเข้าถึงได้จากภายนอก (ห้ามใส่ / ท้าย)
#   local test : http://<ip-เครื่องคุณ>:5090   (หรือ URL ของ ngrok)
#   production : https://<โดเมนจริง>
# หมายเหตุ: นี่ไม่ใช่ endpoint ของ LINE — endpoint push อยู่ในโค้ดแล้ว
APP_BASE_URL=http://127.0.0.1:5090

# ต้องตั้งเป็นค่าสุ่มยาว ๆ บน production ไม่งั้น session หลุดทุกครั้งที่ restart
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# เปิด Werkzeug debugger — ห้ามเปิดบน production เด็ดขาด (รัน code จาก browser ได้)
FLASK_DEBUG=false

# ตั้ง true เมื่อรันหลัง HTTPS แล้ว (จะเปิด SameSite=None; Secure ให้ LINE webview)
SESSION_COOKIE_SECURE=false

PORT=5090
