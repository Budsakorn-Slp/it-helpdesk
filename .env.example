# copy ไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ขึ้น git
# (config.py รองรับทั้งชื่อ ".env" และ "env" เพื่อความเข้ากันได้กับของเดิม)

# ══════════════════════════════════════════════════════════════
#  APP_ENV — สวิตช์ตัวเดียวที่แยก dev ออกจาก prod
# ══════════════════════════════════════════════════════════════
#   dev  = การแจ้งเตือน LINE ทุกชนิดวิ่งไปหา DEV_NOTIFY_EMP_ID คนเดียว
#          debug เปิด, cookie ไม่บังคับ HTTPS
#   prod = ส่งให้คนจริงตาม MANAGER_EMP_ID / WAREHOUSE_EMP_IDS
#          debug ปิด, cookie เป็น SameSite=None; Secure
APP_ENV=dev

# ══════════════════════════════════════════════════════════════
#  Oracle
# ══════════════════════════════════════════════════════════════
# ไม่มีค่า default ในโค้ด ถ้าไม่ตั้ง 3 ตัวนี้ app จะ error ตอน start
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:port/service_name

# path ของ Oracle Instant Client (จำเป็น — server 11.2 ใช้ thin mode ไม่ได้)
#   Windows : C:\instantclient_11_2
#   Linux   : /opt/oracle/instantclient_19_x
#             หรือเว้นว่างถ้าตั้ง LD_LIBRARY_PATH / ldconfig ไว้แล้ว
ORACLE_CLIENT_LIB_DIR=

# driver: auto (ปกติ) | oracledb | cx_Oracle
#   auto จะลอง oracledb ก่อน ถ้า client เก่ากว่า 19.1 จะถอยไปใช้ cx_Oracle เอง
#   จึงไม่ต้องแก้โค้ดเวลาย้ายเครื่อง
ORACLE_DRIVER=auto

# ══════════════════════════════════════════════════════════════
#  LINE Messaging API
# ══════════════════════════════════════════════════════════════
LINE_CHANNEL_TOKEN=

# ปลายทางจริง (ใช้เมื่อ APP_ENV=prod)
MANAGER_EMP_ID=1450094
WAREHOUSE_EMP_IDS=2550335

# ปลายทางตอนเทส (ใช้เมื่อ APP_ENV=dev) — แจ้งเตือนทั้งหมดจะวิ่งมาที่นี่
DEV_NOTIFY_EMP_ID=4670008
# ตั้งไว้ถ้าอยากยิงเข้า LINE ID ตรง ๆ โดยไม่ต้อง lookup จาก DB
DEV_NOTIFY_LINE_ID=

# ══════════════════════════════════════════════════════════════
#  Flask
# ══════════════════════════════════════════════════════════════
# URL ที่ผู้ใช้กดจากข้อความ LINE ต้องเข้าถึงได้จากภายนอก (ห้ามใส่ / ท้าย)
#   local test : http://<ip-เครื่องคุณ>:5090   (หรือ URL ของ ngrok)
#   production : https://<โดเมนจริง>
# ระวัง: ตั้งได้ค่าเดียว ถ้าใส่ซ้ำ 2 บรรทัด บรรทัดล่างจะทับบรรทัดบน
APP_BASE_URL=http://127.0.0.1:5090

# ต้องตั้งเป็นค่าสุ่มยาว ๆ บน production ไม่งั้น session หลุดทุกครั้งที่ restart
# และถ้ารัน gunicorn หลาย worker จะหลุดแบบสุ่มด้วย
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

PORT=5090

# ค่าปกติมาจาก APP_ENV แล้ว ตั้งตรงนี้เฉพาะเวลาอยาก override
#FLASK_DEBUG=false
#SESSION_COOKIE_SECURE=true
#NOTIFY_LOG=true
